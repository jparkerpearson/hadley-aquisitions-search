modules = ["web", "nodejs-20", "python-base-3.13"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Website preview"

[[workflows.workflow]]
name = "Website preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/preview.mjs"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3001

[objectStorage]
defaultBucketID = "replit-objstore-fba77129-8e8f-4a06-91cb-7824cef12b7f"

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "start"]
build = ["npm", "ci"]
publicDir = "."
